<?xml version="1.0" encoding="UTF-8"?>
<!--
    Awake — a watch face that reports how long you have been awake instead of the time of day.

    Wear OS 6 only accepts watch faces written in the Watch Face Format, and such a package cannot
    contain code. Everything this face knows therefore arrives as complication data from the
    companion app (com.awakeface.watch), one type per job:

      slot 0, WEIGHTED_ELEMENTS -> the band around the rim: the last 24 hours, one weighted
                                   segment per stretch spent awake or asleep, already coloured in
                                   the scheme the wearer picked
      slot 1, SHORT_TEXT        -> the readout, split so it can be set at two sizes: hours as the
                                   text, minutes as the title, both dynamic expressions that tick
                                   on device. Its monochromatic image is the sun or the moon.
      slot 2, LONG_TEXT         -> the display preferences, as a two character code: clock mode
                                   ("0" off, "1" twelve hour, "2" twenty-four hour) then date
                                   ("D" on, "-" off). The face cannot read preferences and its own
                                   configuration cannot reach back to colour the ring, so every
                                   setting travels this one way.

    On the design. One accent, used once — in the band, which is the only place colour carries
    meaning. Everything else is white at three fixed opacities, so the eye lands on the hours
    first, the band second, and the small print only when it goes looking. The band is a hairline
    rather than a stripe: it is a day's shape, not a gauge to be filled.
-->
<WatchFace width="450" height="450" clipShape="CIRCLE">

    <Metadata key="CLOCK_TYPE" value="DIGITAL"/>
    <Metadata key="PREVIEW_TIME" value="10:08:32"/>

    <Scene backgroundColor="#ff000000">

        <!-- The day, drawn around the rim. The whole circle is 24 hours; the seam at the top is
             both "a day ago" and "now", so the segment ending at the top is the stretch you are in
             right now. -->
        <ComplicationSlot
            x="0" y="0" width="450" height="450"
            slotId="0"
            displayName="day_ring_label"
            isCustomizable="FALSE"
            supportedTypes="WEIGHTED_ELEMENTS EMPTY">

            <BoundingOval x="0" y="0" width="450" height="450" outlinePadding="2.0"/>

            <DefaultProviderPolicy
                primaryProvider="com.awakeface.watch/com.awakeface.watch.AwakeComplicationService"
                primaryProviderType="WEIGHTED_ELEMENTS"
                defaultSystemProvider="EMPTY"
                defaultSystemProviderType="EMPTY"/>

            <Complication type="WEIGHTED_ELEMENTS">
                <PartDraw x="0" y="0" width="450" height="450">
                    <!-- Dimmed in ambient: the band is context, not something to keep lit. -->
                    <Variant mode="AMBIENT" target="alpha" value="80"/>
                    <Arc centerX="225" centerY="225" width="432" height="432" startAngle="0" endAngle="360">
                        <WeightedStroke
                            thickness="8"
                            colors="[COMPLICATION.WEIGHTED_ELEMENTS_COLORS]"
                            weights="[COMPLICATION.WEIGHTED_ELEMENTS_WEIGHTS]"/>
                    </Arc>
                </PartDraw>

                <!-- The seam, marked by a hairline rather than a bar: enough to find "now",
                     not enough to read as a segment of its own. -->
                <PartDraw x="0" y="0" width="450" height="450">
                    <Rectangle x="224" y="0" width="2" height="18">
                        <Fill color="#b3ffffff"/>
                    </Rectangle>
                </PartDraw>
            </Complication>
        </ComplicationSlot>

        <!-- The readout. Tapping anywhere opens the settings, because the companion app attaches
             that as the complication's tap action. -->
        <ComplicationSlot
            x="0" y="0" width="450" height="450"
            slotId="1"
            displayName="awake_slot_label"
            isCustomizable="FALSE"
            supportedTypes="SHORT_TEXT EMPTY">

            <BoundingOval x="40" y="40" width="370" height="370" outlinePadding="2.0"/>

            <DefaultProviderPolicy
                primaryProvider="com.awakeface.watch/com.awakeface.watch.AwakeComplicationService"
                primaryProviderType="SHORT_TEXT"
                defaultSystemProvider="EMPTY"
                defaultSystemProviderType="EMPTY"/>

            <Complication type="SHORT_TEXT">

                <!-- Sun while awake, moon while asleep. Small, dim, and above the figure: it
                     answers "which count is this" without competing to be read first. -->
                <PartImage x="211" y="108" width="28" height="28" tintColor="#b3ffffff">
                    <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]"/>
                </PartImage>

                <!-- Hours: the figure the face exists to show. Right-aligned to the centre line so
                     it grows leftward and the pair stays balanced as the count passes 9h and 99h. -->
                <PartText x="10" y="162" width="236" height="130" alpha="255">
                    <Variant mode="AMBIENT" target="alpha" value="0"/>
                    <Text align="END" ellipsis="FALSE">
                        <Font family="SYNC_TO_DEVICE" size="118.0" weight="NORMAL" color="#ffffffff">
                            <Template><![CDATA[%s]]>
                                <Parameter expression="[COMPLICATION.TEXT]"/>
                            </Template>
                        </Font>
                    </Text>
                </PartText>

                <PartText x="10" y="162" width="236" height="130" alpha="0">
                    <Variant mode="AMBIENT" target="alpha" value="255"/>
                    <Text align="END" ellipsis="FALSE">
                        <Font family="SYNC_TO_DEVICE" size="118.0" weight="THIN" color="#ffffffff">
                            <Template><![CDATA[%s]]>
                                <Parameter expression="[COMPLICATION.TEXT]"/>
                            </Template>
                        </Font>
                    </Text>
                </PartText>

                <!-- Minutes: detail, so half the size and two thirds the weight of white. Nudged
                     down so the two sit on a common baseline rather than a common centre. -->
                <PartText x="256" y="214" width="184" height="70">
                    <Text align="START" ellipsis="FALSE">
                        <Font family="SYNC_TO_DEVICE" size="54.0" weight="NORMAL" color="#a6ffffff">
                            <Template><![CDATA[%s]]>
                                <Parameter expression="[COMPLICATION.TITLE]"/>
                            </Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <!-- Time and date. Both are drawn inside this slot because their visibility is decided by
             the preference code it carries, and a Condition can only branch on data in scope. -->
        <ComplicationSlot
            x="0" y="0" width="450" height="450"
            slotId="2"
            displayName="prefs_slot_label"
            isCustomizable="FALSE"
            supportedTypes="LONG_TEXT EMPTY">

            <BoundingOval x="150" y="300" width="150" height="60" outlinePadding="2.0"/>

            <DefaultProviderPolicy
                primaryProvider="com.awakeface.watch/com.awakeface.watch.AwakeComplicationService"
                primaryProviderType="LONG_TEXT"
                defaultSystemProvider="EMPTY"
                defaultSystemProviderType="EMPTY"/>

            <Complication type="LONG_TEXT">

                <Condition>
                    <Expressions>
                        <Expression name="clock24"><![CDATA[subText([COMPLICATION.TEXT], 0, 1) == "2"]]></Expression>
                        <Expression name="clock12"><![CDATA[subText([COMPLICATION.TEXT], 0, 1) == "1"]]></Expression>
                    </Expressions>

                    <Compare expression="clock24">
                        <PartText x="0" y="302" width="450" height="34">
                            <Text align="CENTER">
                                <Font family="SYNC_TO_DEVICE" size="26.0" weight="NORMAL" color="#73ffffff">
                                    <Template><![CDATA[%s]]>
                                        <Parameter expression="icuText(&quot;HH:mm&quot;)"/>
                                    </Template>
                                </Font>
                            </Text>
                        </PartText>
                    </Compare>

                    <Compare expression="clock12">
                        <PartText x="0" y="302" width="450" height="34">
                            <Text align="CENTER">
                                <Font family="SYNC_TO_DEVICE" size="26.0" weight="NORMAL" color="#73ffffff">
                                    <Template><![CDATA[%s]]>
                                        <Parameter expression="icuText(&quot;h:mm a&quot;)"/>
                                    </Template>
                                </Font>
                            </Text>
                        </PartText>
                    </Compare>

                    <!-- Clock off: draw nothing. -->
                    <Default>
                        <PartText x="0" y="302" width="450" height="34" alpha="0">
                            <Text align="CENTER">
                                <Font family="SYNC_TO_DEVICE" size="26.0" color="#73ffffff">
                                    <Template><![CDATA[%s]]>
                                        <Parameter expression="&quot;&quot;"/>
                                    </Template>
                                </Font>
                            </Text>
                        </PartText>
                    </Default>
                </Condition>

                <Condition>
                    <Expressions>
                        <Expression name="showDate"><![CDATA[subText([COMPLICATION.TEXT], 1, 2) == "D"]]></Expression>
                    </Expressions>

                    <Compare expression="showDate">
                        <PartText x="0" y="338" width="450" height="30">
                            <Variant mode="AMBIENT" target="alpha" value="120"/>
                            <Text align="CENTER">
                                <Font family="SYNC_TO_DEVICE" size="21.0" weight="NORMAL" color="#4dffffff">
                                    <Template><![CDATA[%s]]>
                                        <Parameter expression="icuText(&quot;EEE d MMM&quot;)"/>
                                    </Template>
                                </Font>
                            </Text>
                        </PartText>
                    </Compare>

                    <Default>
                        <PartText x="0" y="338" width="450" height="30" alpha="0">
                            <Text align="CENTER">
                                <Font family="SYNC_TO_DEVICE" size="21.0" color="#4dffffff">
                                    <Template><![CDATA[%s]]>
                                        <Parameter expression="&quot;&quot;"/>
                                    </Template>
                                </Font>
                            </Text>
                        </PartText>
                    </Default>
                </Condition>
            </Complication>
        </ComplicationSlot>
    </Scene>
</WatchFace>
